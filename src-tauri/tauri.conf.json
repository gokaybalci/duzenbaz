{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dersplan",
  "mainBinaryName": "dersplan",
  "version": "1.0.0",
  "identifier": "com.dersplan.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Dersplan",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis"],
    "category": "Education",
    "shortDescription": "School timetable builder",
    "longDescription": "Build conflict-free weekly school timetables for classes, teachers and rooms. All data stays on this computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["dersplan"], "name": "Dersplan project", "description": "Dersplan timetable project", "role": "Editor", "mimeType": "application/x-dersplan" }
    ],
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
